{
  "name": "grokipedia-reviewer",
  "version": "2.0.0",
  "description": "Automated Grokipedia article fact-checker using GitHub Copilot SDK with session-based browser automation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "grokipedia-review": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.1.18",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
